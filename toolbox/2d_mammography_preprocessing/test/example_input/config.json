{
  "preprocessing": {
    "input_directory": "INPUT",
    "output_directory": "OUTPUT",
    "num_workers": 4,
    "series_number": 2301101,
    "series_description_suffix": "_harmonized",
    "zscore": {
      "enabled": true,
      "percentiles": [1.0, 99.0]
    },
    "denoise": {
      "method": "cascade",
      "params": {
        "adaptive_median": {
          "ksize": 3
        },
        "gaussian": {
          "ksize": 3,
          "sigma": 0.0
        },
        "anisotropic": {
          "niter": 10,
          "kappa": 50.0,
          "gamma": 0.1,
          "option": 1
        },
        "wavelet": {
          "wavelet": "db1",
          "level": 2
        },
        "cascade": {
          "unsharp_amount": 1.5,
          "unsharp_sigma": 1.0,
          "gaussian_sigma": 0.8
        }
      }
    },
    "clahe": {
      "enabled": true,
      "clip_limit": 0.01
    }
  }
}
